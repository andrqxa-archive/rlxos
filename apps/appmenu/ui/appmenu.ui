Image {
    id: BlurLayer
    layout: "grid"
    src: "/avyos/data/backgrounds/default_blur.png"
    scaleMode: "cover"
    srcOpaque: true
    background: "transparent"
    gradientTop: "transparent"
    gradientBottom: "transparent"
    borderColor: "transparent"
    expand: true

    Button {
        id: DismissArea
        text: ""
        expand: true
        background: "transparent"
        gradientTop: "transparent"
        gradientBottom: "transparent"
        borderColor: "transparent"
        focusedBorderColor: "transparent"
        hoverBackground: "transparent"
        pressedBackground: "transparent"
        shadow: false
        focusRing: false
        onClicked: DismissMenu
    }

    VBox {
        id: Overlay
        spacing: 18
        padding: "28 48 24 48"
        alignment: "center"
        expand: true
        background: "#0B1225AA"
        gradientTop: "#101B35B5"
        gradientBottom: "#090F1FC4"
        borderColor: "transparent"

        HBox {
            id: SearchRow
            alignment: "center"
            spacing: 0
            minHeight: 56
            maxHeight: 56
            expand: false

            SearchInput {
                id: SearchInput
                placeholder: "Search apps"
                onChanged: SearchChanged
                onSubmitted: SearchSubmitted
                minWidth: 420
                maxWidth: 520
                minHeight: 40
                maxHeight: 40
                borderRadius: 12
                textColor: "#1D2A3E"
            }
        }

        Flow {
            id: AppGrid
            expand: true
            layout: "flow"
            alignment: "center"
            overflow: "auto"
            scrollStep: 36
            rowSpacing: 12
            colSpacing: 12
            padding: "6"
            minWidth: 880
            maxWidth: 1040
            background: "transparent"
            gradientTop: "transparent"
            gradientBottom: "transparent"
            borderColor: "transparent"
        }

        Label {
            id: EmptyState
            text: "No apps"
            textAlign: "center"
            textColor: "#E7EEFF"
            minHeight: 22
            maxHeight: 22
            expand: false
        }

        Label {
            id: FooterHint
            text: "Press Esc to close"
            textAlign: "center"
            textColor: "#C8D3EA"
            minHeight: 20
            maxHeight: 20
            expand: false
        }
    }
}
