Page {
    spacing: 10
    padding: "12"
    background: "transparent"
    overflow: "hidden"

    VBox {
        spacing: 10
        expand: true

        HBox {
            spacing: 12
            expand: true

            Card {
                id: SidebarCard
                minWidth: 250
                maxWidth: 280
                padding: "12"
                expand: false

                VBox {
                    spacing: 8
                    expand: true

                    ListView {
                        id: PageList
                        items: "Network|Appearance|Display|Sound|Notifications|Security|User|Services|Distro|Devices|Configs|About"
                        selected: 0
                        rowHeight: 36
                        onChanged: SelectPage
                        expand: true
                    }
                }
            }

            VBox {
                id: PageView
                spacing: 10
                expand: true
                background: "transparent"

                Card {
                    padding: "12"
                    expand: false

                    HBox {
                        spacing: 10
                        expand: false

                        VBox {
                            spacing: 4
                            expand: true

                            Heading {
                                id: PageTitle
                                text: "Network"
                            }

                            Paragraph {
                                id: PageDescription
                                text: "Wired network status, DNS servers, addresses, and the active default route."
                            }
                        }

                        Button {
                            text: "Refresh"
                            onClicked: RefreshPage
                            expand: false
                        }
                    }
                }

                VBox {
                    id: SectionsHost
                    spacing: 10
                    expand: true
                    overflow: "auto"
                    scrollStep: 32
                    padding: "2"
                    background: "transparent"
                }
            }
        }

        Card {
            padding: "10"
            expand: false

            HBox {
                spacing: 10
                expand: false

                StatusLabel {
                    id: Status
                    text: " "
                    minHeight: 22
                    expand: true
                    textAlign: "left"
                }

                PrimaryButton {
                    text: "Apply"
                    onClicked: Apply
                    expand: false
                }

                Button {
                    text: "Cancel"
                    onClicked: Reset
                    expand: false
                }
            }
        }
    }
}
