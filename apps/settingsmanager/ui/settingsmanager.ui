Page {
    spacing: 10
    padding: "12"
    background: "transparent"
    overflow: "hidden"

    VBox {
        spacing: 10
        expand: true

        HBox {
            spacing: 12
            expand: true

            Card {
                id: SidebarCard
                minWidth: 250
                maxWidth: 280
                padding: "12"
                expand: false

                VBox {
                    spacing: 8
                    expand: true

                    Heading {
                        text: "Settings"
                    }

                    Paragraph {
                        text: "Configure system preferences and app behavior."
                    }

                    ListView {
                        id: PageList
                        items: "Appearance|About System"
                        selected: 0
                        rowHeight: 36
                        onChanged: SelectPage
                        expand: true
                    }

                    Paragraph {
                        text: "Settings tree root: /dev/rlxos"
                    }
                }
            }

            VBox {
                id: PageView
                spacing: 10
                expand: true
                background: "transparent"

                Heading {
                    id: PageTitle
                    text: "Appearance"
                }

                Paragraph {
                    id: PageDescription
                    text: "Configure wallpaper, fit mode, background color, and dock placement."
                }

                VBox {
                    id: SectionsHost
                    spacing: 10
                    expand: true
                    overflow: "auto"
                    scrollStep: 32
                    padding: "2"
                    background: "transparent"
                }
            }
        }

        Card {
            padding: "10"
            expand: false

            HBox {
                spacing: 10
                expand: false

                StatusLabel {
                    id: Status
                    text: " "
                    minHeight: 22
                    expand: true
                    textAlign: "left"
                }

                PrimaryButton {
                    text: "Apply"
                    onClicked: Apply
                    expand: false
                }

                Button {
                    text: "Cancel"
                    onClicked: Reset
                    expand: false
                }
            }
        }
    }
}
