component Toolbar {
    direction: "row"
    property spacing: 8
    property padding: "10 12"
    property alignment: "stretch"
    expand: false

    background: "theme.color.surface.glass"
    borderColor: "theme.color.stroke.hairline"
    borderRadius: 14
    shadow: true
    shadowColor: "#101A2B17"
    shadowOffsetY: 2
    shadowSpread: 10
}
